# Headless cache TTL (revalidate windows, in SECONDS)
SITEMAP_CACHE_TTL=86400 #24 hours
METADATA_CACHE_TTL=1800 #30 minutes
HEADER_FOOTER_CACHE_TTL=1800 #30 minutes
PAGE_CACHE_TTL=360 #6 minutes
BLOG_SEARCH_CACHE_TTL=360 #6 minutes
CONTENT_CACHE_TTL=360 #6 minutes
SETTINGS_CACHE_TTL=1800 #30 minutes