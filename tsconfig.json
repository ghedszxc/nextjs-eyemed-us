{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "jsx": "preserve",
    "declaration": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "outDir": "./lib",
    "allowJs": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "preserveSymlinks": true,
    // TODO: Remove commented lines
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "rootDir": "./src",
    // "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@/adapter/*": ["./src/adapter/*"],
      "@/assets/*": ["./src/assets/*"],
      "@/configs/*": ["./src/configs/*"],
      "@/providers/*": ["./src/providers/*"],
      "@/components/*": ["./src/components/*"],
      "@/coremedia-integration/*": ["./src/coremedia-integration/*"],
      "@/platform/*": ["./src/platform/*"],
      "@/widgets/*": ["./src/widgets/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/models/*": ["./src/models/*"],
      "@/logic/*": ["./src/logic/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/styles/*": ["./src/styles/*"],
      "@/fonts/*": ["./public/fonts/*"],
      "@/graphql/*": ["./src/graphql/*"],
      "react": ["./node_modules/@types/react"]
    },
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "./src/**/*",
    "next-env.d.ts",
    "custom.d.ts",
    ".storybook/*.tsx",
    "./src/platform/**/*.stories.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "./node_modules/**/*",
    "./src/components/**/*.stories.tsx", // should be removed once we have a better storybook setup
    "./src/layouts/**/*.stories.tsx" // should be removed once we have a better storybook setup
  ]
}
