{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest": true,
    "es6": true
  },
  "extends": ["plugin:@typescript-eslint/recommended", "next", "next/core-web-vitals", "prettier"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint", "unused-imports", "react-hooks"],
  "settings": {
    "react": {
      "version": "detect" // Tells eslint-plugin-react to automatically detect the version of React to use
    }
  },
  "rules": {
    "@typescript-eslint/no-non-null-assertion": 1,
    "@typescript-eslint/no-non-null-asserted-optional-chain": 1,
    "@typescript-eslint/ban-ts-ignore": 0,
    "@typescript-eslint/ban-ts-comment": 0,
    "@typescript-eslint/no-explicit-any": 1,
    "@typescript-eslint/no-namespace": 0,
    "@typescript-eslint/no-var-requires": 0,
    "@typescript-eslint/no-empty-interface": 1,
    "@next/next/no-sync-scripts": 0,
    "@next/next/no-css-tags": 0,
    "@next/next/no-img-element": 0,
    "jsx-a11y/alt-text": 0,
    // note you must disable the base rule as it can report incorrect errors
    // see: https://stackoverflow.com/a/64024916
    "no-use-before-define": "off",
    "no-console": 1,
    "@typescript-eslint/no-empty-function": 0,
    "react/display-name": 0,
    "@typescript-eslint/ban-types": "warn",
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/member-delimiter-style": "off",
    "@typescript-eslint/no-unused-vars": 1,
    "@typescript-eslint/triple-slash-reference": "warn",
    "camelcase": "off",
    "comma-dangle": [1, "only-multiline"],
    "consistent-return": 1,
    "import/no-unresolved": 0,
    "max-len": 0,
    "no-alert": 1,
    "no-duplicate-imports": "warn",
    "no-extra-semi": 1,
    "no-shadow": 0,
    "no-trailing-spaces": [1, { "skipBlankLines": true }],
    "no-undef": 1,
    "no-underscore-dangle": 0,
    "no-unreachable": 1,
    "no-unused-expressions": 0,
    "no-unused-vars": 0,
    "no-useless-constructor": 0,
    "prefer-const": 0,
    "prefer-destructuring": 0,
    "quotes": [1, "single"],
    "react-hooks/exhaustive-deps": "warn",
    "react-hooks/rules-of-hooks": "warn",
    "react/jsx-no-undef": 1,
    "react/jsx-uses-react": 1,
    "react/jsx-uses-vars": 1,
    "react/no-deprecated": 1,
    "react/no-unused-prop-types": "off",
    "react/prop-types": "off",
    "react/react-in-jsx-scope": "off",
    "semi": ["warn", "never"]
  },
  "globals": {
    "JSX": true,
    "NodeJS": true,
    "React": true
  }
}
